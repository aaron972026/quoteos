# ─── Database ─────────────────────────────────────────────────────────
# Supabase (recommended) or any Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quoteos

# ─── Session ──────────────────────────────────────────────────────────
# 32+ random bytes — generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-please

# ─── Map & Geocoding ──────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
NEXT_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-key

# ─── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="FencePros <quotes@fenceprostulsa.com>"

# ─── Wisetack (financing) ─────────────────────────────────────────────
WISETACK_MERCHANT_ID=
WISETACK_API_KEY=

# ─── GoHighLevel (CRM) ────────────────────────────────────────────────
GHL_LOCATION_ID=
GHL_API_KEY=
GHL_INBOUND_WEBHOOK_URL=

# ─── Housecall Pro (Jobs) — via Make.com ──────────────────────────────
MAKE_HCP_WEBHOOK_URL=

# ─── Admin ────────────────────────────────────────────────────────────
# HTTP Basic Auth password for /admin/* and /api/admin/* (any username).
# Dev-grade: plain string compare. For production switch to bcrypt + session +
# IP allowlist (spec §10/18).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_IP_ALLOWLIST=

# ─── Cron ─────────────────────────────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> on scheduled
# invocations. Required in production; dev requests bypass the check.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ─── Wisetack (financing) — public ────────────────────────────────────
# These are NEXT_PUBLIC_ so the widget can build the pre-qual URL client-side.
NEXT_PUBLIC_WISETACK_MERCHANT_ID=
NEXT_PUBLIC_WISETACK_CHECKOUT_URL=

# ─── Public Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
