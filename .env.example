# ─── Database ─────────────────────────────────────────────────────────
# Supabase (recommended) or any Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quoteos

# ─── Commodity index banner (FRED) ────────────────────────────────────
# Free St. Louis Fed economic-data API; get a key at:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# Powers the "commodity prices moved" banner on /admin/skus when softwood
# lumber or iron/steel PPI swings beyond the per-index threshold MoM.
# If unset, the banner silently hides (no SKU page disruption).
FRED_API_KEY=

# ─── Parcel boundary (Regrid) ─────────────────────────────────────────
# Free dev tier covers ~1k requests/mo. Get a token from your Regrid
# account → API tokens. If unset, /api/v1/parcels/lookup returns 503 and
# the draw screen falls back to no overlay.
REGRID_API_KEY=

# ─── AI photo audit (Anthropic) ───────────────────────────────────────
# Powers the vision audit of uploaded yard photos. Uses Opus 4.7 with adaptive
# thinking — see lib/ai/photo-audit.ts. If unset, the /audit route returns 503
# and the upload flow continues without an audit.
ANTHROPIC_API_KEY=

# ─── Supabase Storage (yard photos) ───────────────────────────────────
# Project URL: https://<project-ref>.supabase.co
# Service role key from Supabase dashboard → Project Settings → API.
# A public bucket named "quote-photos" is expected; create one and set its
# RLS to "anonymous read, authenticated insert" (we upload server-side using
# the service role key, so RLS is mostly belt-and-suspenders here).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=quote-photos

# ─── Session ──────────────────────────────────────────────────────────
# 32+ random bytes — generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-please

# ─── Map & Geocoding ──────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
NEXT_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-key

# ─── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Ivory Fence Co. <quotes@fenceprostulsa.com>"
# Estimator briefing PDF is auto-emailed here on every deposit_paid. Leave
# blank to disable (the Stripe webhook logs and skips). Pipe several with
# commas for cc'ing the office: "ops@example.com, aaron@example.com".
ESTIMATOR_EMAIL=

# ─── Twilio (SMS recovery) ────────────────────────────────────────────
# Account SID + Auth Token from twilio.com Console → Account.
# From number must be an SMS-capable Twilio number in E.164 (+15551234567).
# If unset, the abandoned-cart cron skips SMS and only sends to GHL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Wisetack (financing) ─────────────────────────────────────────────
WISETACK_MERCHANT_ID=
WISETACK_API_KEY=

# ─── GoHighLevel (CRM) ────────────────────────────────────────────────
GHL_LOCATION_ID=
GHL_API_KEY=
GHL_INBOUND_WEBHOOK_URL=

# ─── Housecall Pro (Jobs) — via Make.com ──────────────────────────────
MAKE_HCP_WEBHOOK_URL=

# ─── Admin ────────────────────────────────────────────────────────────
# HTTP Basic Auth password for /admin/* and /api/admin/* (any username).
# Dev-grade: plain string compare. For production switch to bcrypt + session +
# IP allowlist (spec §10/18).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_IP_ALLOWLIST=

# ─── Cron ─────────────────────────────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> on scheduled
# invocations. Required in production; dev requests bypass the check.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ─── Wisetack (financing) — public ────────────────────────────────────
# Your Wisetack-provided pre-qualify link, copied verbatim. Looks like:
#   https://app.wisetack.com/financing/prequalify/<your-slug>
# The widget appends ?amount=<cents>&external_id=<quote_id>&return_url=...
# as query params (Wisetack ignores unknown params if not supported).
NEXT_PUBLIC_WISETACK_PREQUAL_URL=

# ─── Public Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fenceprostulsa.com

# ── Private preview mode ─────────────────────────────────────────
# When SET, the ENTIRE site (customer funnel included) sits behind
# HTTP Basic Auth. Leave UNSET/blank for a public site. Stripe
# webhooks and Vercel cron are excluded so they keep working.
# ADMIN_PASSWORD also opens this gate.
SITE_PASSWORD=""
