{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project settings. Permissions are scoped tight by default — expand as needed for the project.",

  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(make:*)",
      "Bash(just:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(npm install:*)",
      "Bash(npm.cmd install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm.cmd uninstall:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -f /:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)",
      "Bash(:(){:|:&};:)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/credentials*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },

  "hooks": {
    "_comment": "UserPromptSubmit fires on every turn; we use it to keep the rules salient even in long sessions. PreToolUse Bash guard catches the rare case where the deny-list misses something.",

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[CLAUDE.md is in effect: Slice Loop · Hard-Stops (SCOPE/UNCERTAIN/SIZE) · Token Economy · One-Sentence Test before action.]'"
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/bash_guard.py"
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Stop checkpoint: Did the last slice run its VERIFY block? If not, run /check before reporting done.]'"
          }
        ]
      }
    ]
  },

  "model": "opus",

  "outputStyle": "default"
}
